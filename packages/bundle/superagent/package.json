{
  "name": "@deepseek-ai/dsh-superagent",
  "author": "DeepSeek Harness Team <team@dsh.dev>",
  "license": "MIT",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiritsu/DeepSeek-Harness-plugins.git",
    "directory": "packages/bundle/superagent"
  },
  "description": "A proactive agent for one GitHub repository: listens to GitHub and Feishu, evaluates requests under a Policy, and executes each in its own DSH Session with full UI management.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "prompts",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "bundle": "tsdown",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <=0.2.2-alpha.2 || >=0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-instructions": "workspace:*",
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-bash-sandbox": "workspace:*",
    "@deepseek-ai/dsh-command-compact": "workspace:*",
    "@deepseek-ai/dsh-compaction-basic": "workspace:*",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "workspace:*",
    "@deepseek-ai/dsh-persona": "workspace:*",
    "@deepseek-ai/dsh-pwsh-sandbox": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:*",
    "@deepseek-ai/dsh-time-context": "workspace:*",
    "@deepseek-ai/dsh-tool-bash": "workspace:*",
    "@deepseek-ai/dsh-tool-fs": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-jobs": "workspace:*",
    "@deepseek-ai/dsh-tool-pwsh": "workspace:*",
    "@deepseek-ai/dsh-tool-skill": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent-control": "workspace:*",
    "@deepseek-ai/dsh-tool-todo": "workspace:*",
    "@deepseek-ai/dsh-tool-web": "workspace:*",
    "proper-lockfile": "4.1.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-attachment": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-permission-presets": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-scope": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-skill": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-workspace": "^0.2.1-alpha.1 || ^0.2.1-alpha.2 || ^0.2.1-rc.3 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
